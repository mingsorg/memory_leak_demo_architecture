  "cards": [
    {
      "dot": "cyan",
      "title": "The Leak",
      "items": [
        "Log4j ThreadContext entries accumulate per reused Tomcat worker thread",
        "Leak mode skips ThreadContext.clearMap(); toggle changes cleanup, not traffic",
        "OOM in ~20\u201330 min at 5 entries \u00d7 64 KB \u00d7 1 req/s on a 512 MB heap"
      ]
    },
    {
      "dot": "rose",
      "title": "Detection in Elastic",
      "items": [
        "EDOT agent ships OTLP traces, JVM metrics, logs to Serverless ingest",
        "Heap alert (>75%, 3-min avg) fires minutes before OOM; ML job on floor slope",
        "APM error spike + OOM ERROR logs land in Discover",
        "Opt-in elastic-agent ships container logs + dump Filestream"
      ]
    },
    {
      "dot": "emerald",
      "title": "Root-Cause Forensics",
      "items": [
        "jdk-sidecar captures heap dumps cross-container with jcmd (production-safe)",
        "Eclipse MAT headless runs Leak Suspects on hprof dumps",
        "Optional JFR watcher streams recordings for allocation analysis",
        "memory-sampler (opt-in) streams continuous class histograms"
      ]
    }
  ]
